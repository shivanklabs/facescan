# Copy to .env (git-ignored). `uv run tasks setup` does this and replaces every CHANGE_ME with a
# random value. Never commit real values.
FACESCAN_ENV=dev
FACESCAN_LOG_LEVEL=INFO

# Database (native PostgreSQL). `uv run tasks db-init` creates this role and database.
FACESCAN_DB_HOST=localhost
FACESCAN_DB_PORT=5432
FACESCAN_DB_USER=facescan
FACESCAN_DB_PASSWORD=CHANGE_ME
FACESCAN_DB_NAME=facescan
FACESCAN_DB_URL=postgresql+psycopg://facescan:CHANGE_ME@localhost:5432/facescan
# Optional: separate database URL for tests (if unset, tasks test uses FACESCAN_DB_URL).
# FACESCAN_TEST_DB_URL=postgresql+psycopg://facescan:CHANGE_ME@localhost:5432/facescan_test
# PostgreSQL superuser used only by db-init (psql asks for its password; never store it here).
FACESCAN_DB_ADMIN_USER=postgres
# Optional: folder that contains psql if it is not on PATH,
# e.g. C:/Program Files/PostgreSQL/18/bin (Windows) or /usr/lib/postgresql/18/bin (Linux).
FACESCAN_DB_PSQL_DIR=

# Object storage: local filesystem (default adapter). Files live under var/storage (git-ignored).
FACESCAN_STORAGE_ROOT=var/storage
FACESCAN_STORAGE_BUCKET_PHOTOS=facescan-photos
FACESCAN_STORAGE_BUCKET_DERIVATIVES=facescan-derivatives
FACESCAN_STORAGE_BUCKET_QUARANTINE=facescan-quarantine
# Upload parts over 1 MB spool here during a request (deleted afterwards; git-ignored).
FACESCAN_UPLOAD_SPOOL_DIR=var/tmp/uploads
# HMAC key for signed download URLs (at least 32 characters).
FACESCAN_STORAGE_SIGNING_KEY=CHANGE_ME
FACESCAN_STORAGE_URL_EXPIRY_MINUTES=5
# Base URL of the API that serves signed downloads. In public/production mode the API is
# only under /api, so use https://<host>/api there.
FACESCAN_STORAGE_PUBLIC_BASE_URL=http://localhost:8000

# Keys (dev only: master key from env; production uses a KMS adapter)
FACESCAN_KEYS_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# Sign-in: passkeys for guests; one-time staff keys (uv run tasks staff-key) + passkeys for
# staff. No emails are collected. Open the app at this exact origin (passkeys are bound to it).
FACESCAN_AUTH_RP_ID=localhost
FACESCAN_AUTH_RP_ORIGIN=http://localhost:5173
FACESCAN_AUTH_SESSION_SECRET=CHANGE_ME

# Offline face pipeline (ai/, facescan-ai CLI): AES-256-GCM key for benchmark index files.
FACESCAN_BENCH_KEY=CHANGE_ME_BASE64_32_BYTES


# Worker
FACESCAN_WORKER_POLL_INTERVAL_SECONDS=2

# Config files
FACESCAN_CONFIG_ADAPTERS_PATH=settings/services.yaml
FACESCAN_CONFIG_POLICIES_DIR=settings/country-rules

# Frontend (public, baked into the bundle: never put secrets here)
VITE_FACESCAN_API_URL=http://localhost:8000

# Backup (dev only: local filesystem; production uses a cloud adapter)
FACESCAN_BACKUP_DIR=
