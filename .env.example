# Copy to .env (git-ignored) and replace every CHANGE_ME. Never commit real values.
FACESCAN_ENV=dev
FACESCAN_LOG_LEVEL=INFO

# Database
FACESCAN_DB_USER=facescan
FACESCAN_DB_PASSWORD=CHANGE_ME
FACESCAN_DB_NAME=facescan
FACESCAN_DB_URL=postgresql+psycopg://facescan:CHANGE_ME@postgres:5432/facescan

# Object storage (MinIO via S3 API)
FACESCAN_STORAGE_ENDPOINT=http://minio:9000
FACESCAN_STORAGE_ACCESS_KEY=CHANGE_ME
FACESCAN_STORAGE_SECRET_KEY=CHANGE_ME_MIN_8_CHARS
FACESCAN_STORAGE_BUCKET_PHOTOS=facescan-photos
FACESCAN_STORAGE_BUCKET_DERIVATIVES=facescan-derivatives

# Keys (dev only: master key from env; production uses a KMS adapter)
FACESCAN_KEYS_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# Login
FACESCAN_AUTH_RP_ID=localhost
FACESCAN_AUTH_RP_ORIGIN=http://localhost:5173
FACESCAN_AUTH_SESSION_SECRET=CHANGE_ME

# Email (magic links). Dev uses a local SMTP catcher; no paid provider.
FACESCAN_EMAIL_SMTP_HOST=CHANGE_ME
FACESCAN_EMAIL_SMTP_PORT=1025

# Worker
FACESCAN_WORKER_POLL_INTERVAL_SECONDS=2

# Config files
FACESCAN_CONFIG_ADAPTERS_PATH=config/adapters.yaml
FACESCAN_CONFIG_POLICIES_DIR=config/policies

# Frontend (public, baked into the bundle: never put secrets here)
VITE_FACESCAN_API_URL=http://localhost:8000
