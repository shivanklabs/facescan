# FACESCAN_PREVIEW_JPEG_QUALITY=85
# FACESCAN_ATTEMPT_RETENTION_DAYS=7
# FACESCAN_INVITE_DEFAULT_DAYS=14
# FACESCAN_SEARCH_PER_USER_PER_HOUR=10
# FACESCAN_SEARCH_PER_EVENT_PER_HOUR=500
# FACESCAN_DISCOVER_MAX_FRAMES=7
# FACESCAN_LIVENESS_ADAPTER=silent_face
