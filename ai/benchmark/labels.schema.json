{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FaceScan benchmark labels",
  "type": "object",
  "required": [
    "dataset_id",
    "consent_reference",
    "images"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "type": "string"
    },
    "consent_reference": {
      "type": "string",
      "description": "ID of the signed consent record"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "faces"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "faces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "person_id",
                "bbox"
              ],
              "additionalProperties": false,
              "properties": {
                "person_id": {
                  "type": "string",
                  "description": "opaque ID, never a name"
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    }
  }
}
